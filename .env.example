# Robot Vision Platform Support Agent — environment variables
# Fill in your OpenRouter API key, then run:
#   set -a && source .env && set +a
#   .venv/bin/python src/evaluate.py

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# 사내 LLM 게이트웨이 식별 헤더(선택) — 채우면 모든 OpenRouter 호출(chat/embeddings/
# rerank)에 x-service-id / x-user-id 가 첨부된다. 공개 OpenRouter엔 불필요(비워둠).
# LLM_SERVICE_ID=voc-agent
# LLM_USER_ID=

# Optional overrides
# RVP_MODEL=openai/gpt-4o-mini
# RVP_JUDGE_MODEL=anthropic/claude-3.5-sonnet
# RVP_PORT=8001

# 임베딩 백엔드/모델 — 기본 fastembed(로컬 MiniLM). 사내 게이트웨이 사용 시:
# RVP_EMBED_BACKEND=openrouter
# RVP_EMBED_MODEL=baai/bge-m3      # 미설정 시 openrouter 백엔드 기본값=bge-m3
# 주의: bge-m3는 1024-dim·코사인 분포가 달라 coverage 게이트(gate_cos) 재보정 필요.
# RVP_GATE_COS=0.85                # L2 /selfcheck/evaluate-param 으로 검증 후 설정 권장

# 추천 2차 재순위(reranker) — rerank 점수로 정렬·coverage 게이트·신뢰도 산출.
# OPENROUTER_API_KEY(+게이트웨이 /rerank) 필요. paraphrase 평가 P@1 .898→1.0(측정).
# RVP_RERANK=1
# RVP_RERANK_MODEL=cohere/rerank-v3.5

# Jira 웹훅(증분 KB 갱신) — Jira System→Webhooks 에 URL 등록:
#   https://<host>/webhook/jira?secret=<아래값>   (이벤트: Issue created/updated/deleted)
# 새/변경 이슈가 들어오면 해당 이슈만 재적재 + 추천 KB 캐시 무효화. 비우면 인증 없이 허용.
# JIRA_WEBHOOK_SECRET=

# LLM 엔진: agno(OpenRouter HTTP) 단일. 모델/엔드포인트는 위 OPENROUTER_* 로 설정.

# --- Jira 연동 (서비스 계정 권장) ---
# 중앙(사내 웹) 배포 시: 전용 서비스(봇) 계정 1개를 사용한다.
#   - RCA 댓글이 이 계정 명의로 게시됨 (개인 계정 지양)
#   - 최소 권한: 해당 프로젝트 '조회 + 댓글 추가(Add Comments)'만. 관리자 권한 금지.
#   - 자격증명은 .env 또는 온보딩(tmp_db/app_config.json, 0600)에 서버측 보관.
JIRA_BASE_URL=
JIRA_PROJECT_KEY=
# Jira Cloud 인증 (서비스 계정 email + API token — 둘 다 채우기)
JIRA_EMAIL=
JIRA_API_TOKEN=
# Jira Server/Data Center 인증 (서비스 계정 PAT 하나만; Cloud와 택1)
JIRA_PAT=

# KB 보조 원천 — Jira 미러(data/all_raw_issues.json)에 합쳐 읽는 파일 목록(콤마 구분).
# 미러는 src/jira_sync.py 가 소유한다(삭제 대조 removed = known - live). Jira 에 없는
# 키를 미러에 직접 넣으면 다음 대조 회차에 전부 지워지므로, 보조 지식은 이쪽으로 붙인다.
# 키가 겹치면 미러가 이긴다(Jira 가 정본). 현황은 GET /knowledge/sources.
# RVP_KB_EXTRA=data/voc_mock_issues.json
